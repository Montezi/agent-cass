# Copie para .env e preencha. O .env nunca vai para o git.

# Google Cloud (Gemini pela Vertex AI, autenticação por ADC; não há chave de API)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# O agente fixa thinking_level = "low" (NIVEL_DE_PENSAMENTO em cass/agente.py): no
# gemini-3.8-flash, a mediana de resposta caiu de ~10 s para ~4 s. Esse modelo aceita
# low, medium e high (não tem minimal). Ao trocar de modelo, confira os níveis aceitos;
# modelos sem thinking_level (ex.: gemini-2.5-*) respondem 400 da Vertex AI.
GEMINI_MODEL=gemini-3.8-flash


# Frontend (CORS e dados)
APP_ORIGIN=http://localhost:5173
DADOS_BASE=http://localhost:5173/dados

# Previsão da GET /api/clima (e do previsao_tempo): Meteomatics, só com os dois
# preenchidos; sem eles, começa na Open-Meteo (sem chave) e cai no
# {DADOS_BASE}/forecast-snapshot.json. No Cloud Run, vêm do Secret Manager.
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# Decider opcional: construa a imagem com INCLUIR_DECIDER=true para incluir o
# servidor CPU e os pesos locais. Essa imagem ativa o Decider por padrão;
# DECIDER_ATIVO=false permite comparar com as regras fixas sem carregar o modelo.
# Com false, o Cass usa as regras fixas e os valores padrão seguros.
DECIDER_ATIVO=false
DECIDER_URL=http://127.0.0.1:8099/v1/systemone
# Somente na imagem com Decider: caminhos e prazos já têm estes padrões.
# DECIDER_MODELO=/opt/decider-model
# DECIDER_STARTUP_TIMEOUT_S=240
# DECIDER_SHUTDOWN_TIMEOUT_S=10
